APP_URL=http://localhost:3000

# Les valeurs suivantes sont disponibles dans le portail développeur Notion.
NOTION_CLIENT_ID=remplacer_par_le_client_id
NOTION_CLIENT_SECRET=remplacer_par_le_client_secret

# URI à fourninr lors de la création de l'espace d'intégration OAuth 
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/notion/callback

NOTION_AUTH_URL=https://api.notion.com/v1/oauth/authorize
NOTION_API_VERSION=2026-03-11

# Clé de 32 octets encodée en Base64.
# Générer avec node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=remplacer_par_une_cle_base64_de_32_octets

# Chemin de la base SQLite locale.
DATABASE_PATH=./.data/app-data.sqlite
